# ─────────────────────────────────────────────────────────
# SIA RAG Microservice — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
# Port on which the FastAPI server listens on the host
APP_PORT=8000

# Number of Uvicorn worker processes.
# Week 7 finding: a single worker saturates at ~150 concurrent users.
# Set to (2 * CPU_CORES + 1) for production. E.g. 4-core machine → 9 workers.
UVICORN_WORKERS=1

# ── Redis Cache ───────────────────────────────────────────
# Hostname of the Redis service (use 'redis' inside Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Set to "false" to disable caching entirely (useful for profiling real latency)
REDIS_ENABLED=true

# Cache TTL in seconds. Results expire after this duration.
# Documents re-ingested within the TTL will trigger an explicit cache flush.
REDIS_CACHE_TTL_SECONDS=3600

# ── Vector Store ─────────────────────────────────────────
# Path where LanceDB persists its data (relative to the app working directory)
# Mapped to a Docker volume in docker-compose.yml for persistence.
LANCE_STORE_DIR=vector_store
